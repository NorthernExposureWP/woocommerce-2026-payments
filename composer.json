{
  "name": "dima/wordpress-deep-dive-2026",
  "type": "project",
  "require": {
    "php": "^8.4",
    "johnpbloch/wordpress": "^7.1"
  },
  "extra": {
    "wordpress-install-dir": "public"
  },
  "config": {
    "allow-plugins": {
      "johnpbloch/wordpress-core-installer": true
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "phpstan/phpstan": "^2.2",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "scripts": {
    "post-install-cmd": [
      "@php bin/install.php"
    ],
    "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse"
  }
}
