{
  "name": "dima/wordpress-deep-dive-2026",
  "type": "project",
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    }
  ],
  "require": {
    "php": "^8.4",
    "johnpbloch/wordpress": "^7.1",
    "composer/installers": "^2.3",
    "wpackagist-plugin/woocommerce-paypal-payments": "^4.1",
    "wpackagist-plugin/authorize-net-payments-for-woocommerce": "^1.0"
  },
  "extra": {
    "wordpress-install-dir": "public"
  },
  "config": {
    "allow-plugins": {
      "johnpbloch/wordpress-core-installer": true,
      "composer/installers": true
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "phpstan/phpstan": "^2.2",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "scripts": {
    "post-install-cmd": [
      "@php bin/install.php"
    ],
    "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse"
  }
}
